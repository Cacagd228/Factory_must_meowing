#=====================================================
#      FMM Island World Generation Configuration      
#=====================================================
[general]

	[general.spatial_grid]
		#Grid spacing (cell size in blocks) for procedural island placement.
		#Default: 700.0 (Optimal spacing for oceanic island discovery)
		# Default: 700.0
		# Range: 128.0 ~ 4096.0
		grid_size = 700.0
		#Probability that a grid cell contains an island (0.0 to 1.0).
		#Default: 0.75 (75% islands, 25% deep ocean abyss)
		# Default: 0.75
		# Range: 0.0 ~ 1.0
		spawn_chance = 0.75

	[general.coast_and_lagoons]
		#Width of the sandy/snowy beach ring around all islands in blocks.
		#Default: 20.0 blocks
		# Default: 20.0
		# Range: 4.0 ~ 64.0
		beach_width = 20.0
		#Minimum radius/width of the shallow reef lagoon (10-14 blocks depth) around islands.
		#Default: 30.0 blocks
		# Default: 30.0
		# Range: 0.0 ~ 200.0
		warm_ocean_min_radius = 30.0
		#Maximum radius/width of the shallow reef lagoon (10-14 blocks depth) around islands.
		#Default: 80.0 blocks
		# Default: 80.0
		# Range: 10.0 ~ 300.0
		warm_ocean_max_radius = 80.0

	[general.climate_tiers]
		#Spawn weight for HOT islands (Savannas, Badlands Mesas, Mangrove Oases).
		#Default: 0.15 (15%)
		# Default: 0.15
		# Range: 0.0 ~ 1.0
		hot_island_chance = 0.15
		#Spawn weight for WARM islands (Tropical Jungles, Cherry Blossom Hills, Sunflower Plains).
		#Default: 0.25 (25%)
		# Default: 0.25
		# Range: 0.0 ~ 1.0
		warm_island_chance = 0.25
		#Spawn weight for TEMPERATE islands (Oak/Birch Forest Hills, Dark Oak Woods, Green Alpine Meadows).
		#Default: 0.30 (30%)
		# Default: 0.3
		# Range: 0.0 ~ 1.0
		temperate_island_chance = 0.3
		#Spawn weight for COLD islands (Boreal Pine & Spruce Taiga, Windswept Cliffs - NO SNOW on the ground).
		#Default: 0.15 (15%)
		# Default: 0.15
		# Range: 0.0 ~ 1.0
		cold_island_chance = 0.15
		#Spawn weight for SNOWY islands (Snowy Taiga, Alpine Frozen Peaks, Ice Spikes & Tundra - WINTER).
		#Default: 0.15 (15%)
		# Default: 0.15
		# Range: 0.0 ~ 1.0
		snowy_island_chance = 0.15
