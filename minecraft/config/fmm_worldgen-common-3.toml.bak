	[islands.small_islands]
		#Grid cell spacing for small islands (in blocks, default: 1373.0)
		# Default: 1373.0
		# Range: 300.0 ~ 10000.0
		grid_size = 1373.0
		#Minimum radius for small islands (diameter = 2 * radius, default: 75.0 -> diameter 150 blocks)
		# Default: 75.0
		# Range: 20.0 ~ 500.0
		min_radius = 75.0
		#Maximum radius for small islands (diameter = 2 * radius, default: 87.5 -> diameter 175 blocks)
		# Default: 87.5
		# Range: 20.0 ~ 500.0
		max_radius = 87.5
		#Spawn probability per grid cell for small islands (0.0 to 1.0, default: 0.32 = 32% chance)
		# Default: 0.32
		# Range: 0.0 ~ 1.0
		spawn_chance = 0.32

	[islands.medium_islands]
		#Grid cell spacing for medium islands (in blocks, default: 2111.0)
		# Default: 2111.0
		# Range: 300.0 ~ 10000.0
		grid_size = 2111.0
		#Minimum radius for medium islands (diameter = 2 * radius, default: 125.0 -> diameter 250 blocks)
		# Default: 125.0
		# Range: 20.0 ~ 1000.0
		min_radius = 125.0
		#Maximum radius for medium islands (diameter = 2 * radius, default: 175.0 -> diameter 350 blocks)
		# Default: 175.0
		# Range: 20.0 ~ 1000.0
		max_radius = 175.0
		#Spawn probability per grid cell for medium islands (0.0 to 1.0, default: 0.26 = 26% chance)
		# Default: 0.26
		# Range: 0.0 ~ 1.0
		spawn_chance = 0.26

	[islands.large_islands]
		#Grid cell spacing for large islands (in blocks, default: 3329.0)
		# Default: 3329.0
		# Range: 300.0 ~ 10000.0
		grid_size = 3329.0
		#Minimum radius for large islands (diameter = 2 * radius, default: 187.5 -> diameter 375 blocks)
		# Default: 187.5
		# Range: 20.0 ~ 2000.0
		min_radius = 187.5
		#Maximum radius for large islands (diameter = 2 * radius, default: 212.5 -> diameter 425 blocks)
		# Default: 212.5
		# Range: 20.0 ~ 2000.0
		max_radius = 212.5
		#Spawn probability per grid cell for large islands (0.0 to 1.0, default: 0.20 = 20% chance)
		# Default: 0.2
		# Range: 0.0 ~ 1.0
		spawn_chance = 0.2

	[islands.archetypes]
		#Chance of generating winter/snowy island variants (0.0 to 1.0, default: 0.30 = 30% winter chance)
		# Default: 0.3
		# Range: 0.0 ~ 1.0
		winter_island_chance = 0.3

[ocean_and_beaches]
	#Width of the continuous sandy/snowy beach perimeter (in blocks, default: 20.0)
	# Default: 20.0
	# Range: 4.0 ~ 100.0
	beach_width = 20.0
	#Minimum width of warm ocean coral reef ring around warm islands (in blocks, default: 30.0)
	# Default: 30.0
	# Range: 0.0 ~ 500.0
	warm_ocean_min_radius = 30.0
	#Maximum width of warm ocean coral reef ring around warm islands (in blocks, default: 120.0)
	# Default: 120.0
	# Range: 0.0 ~ 1000.0
	warm_ocean_max_radius = 120.0
